{
  "name": "ferreteria-backend",
  "version": "1.0.0",
  "description": "Backend del sistema de inventario para ferretería",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/db/migrate.js",
    "migrate:reset": "node src/db/migrate.js --reset",
    "seed": "node src/db/seed.js",
    "db:fresh": "npm run migrate:reset && npm run seed"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
